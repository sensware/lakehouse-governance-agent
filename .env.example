# Copy to .env — never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5      # cheaper than the default claude-opus-5-5
#                                      # (claude-opus-5 pins the previous default)
# ANTHROPIC_EFFORT=high                # default; Opus 5.5 would otherwise use "medium".
#                                      # Set empty to omit (models without effort support)
# EMBED_MODEL=BAAI/bge-small-en-v1.5
